FROM node:22-slim AS source

ARG UPSTREAM_REPO=https://github.com/holotr/ming-salvage-sim.git
ARG UPSTREAM_REF=upstream-patch
ARG UPSTREAM_REV=main

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN git init . \
    && echo "Upstream cache key: ${UPSTREAM_REV}" \
    && git remote add origin "${UPSTREAM_REPO}" \
    && git fetch --depth 1 origin "${UPSTREAM_REF}" \
    && git checkout --detach FETCH_HEAD \
    && rm -rf .git

FROM node:22-slim AS web-build

WORKDIR /app/web
COPY --from=source /src/web/package*.json ./
RUN npm ci
COPY --from=source /src/web ./
RUN npm run build

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MING_SIM_USER_DATA_DIR=/app/data \
    MING_SIM_DATA_DIR=/app/data \
    MING_SIM_RUN_USER=app

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --home-dir /app app

COPY --from=source /src/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY --from=source /src/content ./content
COPY --from=source /src/ming_sim ./ming_sim
COPY --from=source /src/.agno_skills ./.agno_skills
COPY --from=source /src/web_app.py ./
COPY --from=web-build /app/web/dist ./web/dist

RUN mkdir -p /app/data \
    && chown -R app:app /app

EXPOSE 8010

CMD ["python", "-m", "uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8010"]
